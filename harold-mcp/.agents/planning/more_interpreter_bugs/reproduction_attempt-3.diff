     def _log(self) -> logging.Logger:
         """The logger for this class"""
         return get_logger(self.__class__.__name__)
+
+
+def describe_exception_chain(exc: BaseException, max_length: int = 2000) -> str:
+    """Render an exception and its cause/context chain as `Type: message <- Type: message`.
+
+    Server-side diagnostics only: MCP clients receive a wrapper's message, so an
+    unexpected failure's type and chained causes are otherwise lost. Truncated to
+    `max_length` characters (a non-positive `max_length` disables truncation) so the
+    text can also be embedded in a client-visible error message.
+    """
+    parts: list[str] = []
+    seen: set[int] = set()
+    current: BaseException | None = exc
+    while current is not None and id(current) not in seen:
+        seen.add(id(current))
+        message = str(current)
+        parts.append(f"{type(current).__name__}: {message}" if message else type(current).__name__)
+        current = current.__cause__ if current.__cause__ is not None else current.__context__
+    text = " <- ".join(parts)
+    if max_length <= 0 or len(text) <= max_length:
+        return text
+    return text[:max_length] + "..."
