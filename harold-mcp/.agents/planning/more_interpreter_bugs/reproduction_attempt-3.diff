+def test_unexpected_worker_exception_is_logged_with_its_chain(caplog: pytest.LogCaptureFixture) -> None:
+    """Anything that is not a crash/timeout reaches `maude_run`'s generic wrapper.
+
+    The log line is the only record of its type, so it must carry the chain and the
+    remote traceback (bug 2 can only be diagnosed from here).
+    """
+    executor = make_executor(lambda: FakeExecutor(futures=[FakeFuture(exc=ValueError("boom"))]))
+
+    with caplog.at_level(logging.ERROR), pytest.raises(ValueError, match="boom"):
+        executor.diagnostics("hello.maude")
+
+    records = [record for record in caplog.records if "failed with ValueError" in record.getMessage()]
+    assert len(records) == 1
+    assert "ValueError: boom" in records[0].getMessage()
+    assert records[0].exc_info is not None
+
+
+def test_unexpected_submit_failure_is_logged_and_propagates(caplog: pytest.LogCaptureFixture) -> None:
+    """A shut-down pool raises `RuntimeError`, which the crash/timeout mapping misses."""
+    shutdown = RuntimeError("cannot schedule new futures after shutdown")
+    executor = make_executor(lambda: FakeExecutor(submit_exc=shutdown))
+
+    with caplog.at_level(logging.ERROR), pytest.raises(RuntimeError, match="cannot schedule"):
+        executor.diagnostics("hello.maude")
+
+    records = [record for record in caplog.records if "Failed to submit task" in record.getMessage()]
+    assert len(records) == 1
+    assert "RuntimeError: cannot schedule new futures after shutdown" in records[0].getMessage()
+    assert records[0].exc_info is not None
+
+
+def test_pool_creation_failure_is_logged_and_propagates(caplog: pytest.LogCaptureFixture) -> None:
+    """A spawn failure (`OSError`) also bypasses the crash/timeout mapping."""
+    spawn_error = OSError("cannot spawn")
+
+    def factory() -> FakeExecutor:
+        raise spawn_error
+
+    executor = make_executor(factory)
+
+    with caplog.at_level(logging.ERROR), pytest.raises(OSError, match="cannot spawn"):
+        executor.diagnostics("hello.maude")
+
+    records = [record for record in caplog.records if "Failed to create Maude process pool" in record.getMessage()]
+    assert len(records) == 1
+    assert "OSError: cannot spawn" in records[0].getMessage()
+    assert records[0].exc_info is not None
+
